{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MKLink Site Agent",
  "version": "0.1.9",
  "identifier": "com.microkeen.mklink-site-agent",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MKLink Site Agent",
        "width": 980,
        "height": 760,
        "minWidth": 740,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
